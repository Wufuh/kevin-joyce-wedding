---
import { Image } from "astro:assets";
import kobeImage from "../assets/kobe.jpg";
import kobeFamily from "../assets/kobe-family.jpg";
import proposalYes from "../assets/proposal-yes.jpg";
import metOnline from "../assets/met-online.jpg";
import firstDate from "../assets/first-date.jpg";
import official from "../assets/official.jpg";
import finale from "../assets/finale.jpg";
import { useTranslations, type Lang, type UiKey } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type PanelImage = {
  image: ImageMetadata;
  altKey: UiKey;
  photoClass?: string;
};

const panels: {
  n: number;
  titleKey: UiKey;
  captionKey: UiKey;
  altKey: UiKey;
  image: ImageMetadata;
  kind: "anime" | "photo";
  tone: string;
  frameClass?: string;
  photoClass?: string;
  /** When set, render a side-by-side (stacked on mobile) diptych instead of a single image. */
  diptych?: [PanelImage, PanelImage];
}[] = [
  {
    n: 1,
    titleKey: "story.panel1Title",
    captionKey: "story.panel1Caption",
    altKey: "story.panel1Alt",
    image: metOnline,
    kind: "photo",
    tone: "rose",
    frameClass: "comic-frame-met",
    photoClass: "comic-photo-met",
  },
  {
    n: 2,
    titleKey: "story.panel2Title",
    captionKey: "story.panel2Caption",
    altKey: "story.panel2Alt",
    image: firstDate,
    kind: "photo",
    tone: "cream",
    frameClass: "comic-frame-first-date",
    photoClass: "comic-photo-first-date",
  },
  {
    n: 3,
    titleKey: "story.panel3Title",
    captionKey: "story.panel3Caption",
    altKey: "story.panel3Alt",
    image: official,
    kind: "photo",
    tone: "sage",
    frameClass: "comic-frame-official",
    photoClass: "comic-photo-official",
  },
  {
    n: 4,
    titleKey: "story.panel5Title",
    captionKey: "story.panel5Caption",
    altKey: "story.kobeAlt",
    image: kobeImage,
    kind: "photo",
    tone: "warm",
    frameClass: "comic-frame-kobe comic-frame-diptych",
    photoClass: "comic-photo-kobe",
    diptych: [
      {
        image: kobeImage,
        altKey: "story.kobeAlt",
        photoClass: "comic-photo-kobe",
      },
      {
        image: kobeFamily,
        altKey: "story.kobeFamilyAlt",
        photoClass: "comic-photo-kobe-family",
      },
    ],
  },
  {
    n: 5,
    titleKey: "story.panel4Title",
    captionKey: "story.panel4Caption",
    altKey: "story.proposalAlt",
    image: proposalYes,
    kind: "photo",
    tone: "blush",
    frameClass: "comic-frame-proposal",
    photoClass: "comic-photo-proposal",
  },
  {
    n: 6,
    titleKey: "story.panel6Title",
    captionKey: "story.panel6Caption",
    altKey: "story.panel6Alt",
    image: finale,
    kind: "photo",
    tone: "gold",
    frameClass: "comic-frame-finale",
    photoClass: "comic-photo-finale",
  },
];
---

<section class="section section-alt story-comic-section">
  <div class="container">
    <ol class="comic-strip" aria-label={t("story.title")}>
      {
        panels.map((panel) => (
          <li class={`comic-panel tone-${panel.tone}`}>
            <figure class:list={["comic-frame", panel.frameClass]}>
              {panel.diptych ? (
                <div class="comic-diptych">
                  {panel.diptych.map((shot) => (
                    <Image
                      src={shot.image}
                      alt={t(shot.altKey)}
                      widths={[300, 450, 600, 900]}
                      sizes="(min-width: 768px) 21vw, 90vw"
                      quality={82}
                      class:list={[
                        "comic-photo",
                        panel.kind === "anime" && "comic-photo-anime",
                        shot.photoClass,
                      ]}
                      loading="lazy"
                    />
                  ))}
                </div>
              ) : (
                <Image
                  src={panel.image}
                  alt={t(panel.altKey)}
                  widths={[400, 600, 900, 1200]}
                  sizes="(min-width: 768px) 42vw, 90vw"
                  quality={82}
                  class:list={[
                    "comic-photo",
                    panel.kind === "anime" && "comic-photo-anime",
                    panel.photoClass,
                  ]}
                  loading="lazy"
                />
              )}
            </figure>
            <div class="comic-caption">
              <h2 class="comic-caption-title">{t(panel.titleKey)}</h2>
              <p class="comic-caption-text">{t(panel.captionKey)}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
