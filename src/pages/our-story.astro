---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Our Story"
  description="The story of Kevin and Joyce — placeholder chapters you can edit anytime."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Our story</p>
      <h1>How we found each other</h1>
      <p class="lede">
        These sections are placeholders — swap in your own words whenever you're ready.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>How we met</h2>
        <p>
          [Edit this] Share the first hello — where you were, what stood out, and
          the small moment that made you curious about each other.
        </p>
      </article>
      <article class="card">
        <h2>Falling in love</h2>
        <p>
          [Edit this] Favorite early dates, inside jokes, and the everyday habits
          that made life together feel natural.
        </p>
      </article>
      <article class="card">
        <h2>The proposal</h2>
        <p>
          [Edit this] Tell the proposal story — the setting, the surprise (or not),
          and how you celebrated afterward.
        </p>
      </article>
      <article class="card">
        <h2>Looking ahead</h2>
        <p>
          [Edit this] A short note about what you're most excited to share with
          family and friends in Taipei.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
