---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Registry"
  description="Registry links for Kevin and Joyce — coming soon."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Gifts</p>
      <h1>Registry</h1>
      <p class="lede">
        Your presence is the gift we're most looking forward to. If you'd like to
        give something as well, registry links will appear here soon.
      </p>
      <div class="card" style="max-width: 36rem; margin-top: 1.5rem;">
        <h2>Links coming soon</h2>
        <p>
          We'll add store or experience registries here when they're ready.
          Placeholder for future links — nothing to click just yet.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
