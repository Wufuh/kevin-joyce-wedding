---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t("home.metaTitle")}
  description={t("home.metaDescription")}
>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">{t("home.eyebrow")}</p>
        <h1>Kevin &amp; Joyce</h1>
        <p class="hero-meta">
          <strong>{t("home.date")}</strong><br />
          {t("home.venue")}
        </p>
        <p class="lede">{t("home.lede")}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localizedPath(lang, "rsvp")}>{t("home.ctaRsvp")}</a>
          <a class="btn btn-secondary" href={localizedPath(lang, "details")}>{t("home.ctaDetails")}</a>
        </div>
      </div>
      <div class="placeholder-hero" role="img" aria-label="Decorative monogram placeholder">
        K &amp; J
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <p class="eyebrow">{t("home.storyEyebrow")}</p>
        <h2>{t("home.storyTitle")}</h2>
        <p>{t("home.storyBody")}</p>
        <a href={localizedPath(lang, "our-story")}>{t("home.storyLink")}</a>
      </article>
      <article class="card">
        <p class="eyebrow">{t("home.travelEyebrow")}</p>
        <h2>{t("home.travelTitle")}</h2>
        <p>{t("home.travelBody")}</p>
        <a href={localizedPath(lang, "travel")}>{t("home.travelLink")}</a>
      </article>
    </div>
  </section>
</BaseLayout>
