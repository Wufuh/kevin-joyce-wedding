---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t("registry.metaTitle")}
  description={t("registry.metaDescription")}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t("registry.eyebrow")}</p>
      <h1>{t("registry.title")}</h1>
      <p class="lede">{t("registry.lede")}</p>
      <div class="card" style="max-width: 36rem; margin-top: 1.5rem;">
        <h2>{t("registry.comingTitle")}</h2>
        <p>{t("registry.comingBody")}</p>
      </div>
    </div>
  </section>
</BaseLayout>
