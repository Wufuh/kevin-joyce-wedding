---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);

const hotelQuery = encodeURIComponent(
  "Mandarin Oriental Taipei, 158 Dunhua North Road, Songshan District, Taipei",
);

const maps = [
  {
    id: "from-tpe",
    title: t("travel.mapFromTpeTitle"),
    originLabel: "Taiwan Taoyuan International Airport (TPE)",
    tip: t("travel.mapFromTpeTip"),
  },
  {
    id: "from-tsa",
    title: t("travel.mapFromTsaTitle"),
    originLabel: "Taipei Songshan Airport (TSA)",
    tip: t("travel.mapFromTsaTip"),
  },
  {
    id: "from-main",
    title: t("travel.mapFromMainTitle"),
    originLabel: "Taipei Main Station",
    tip: t("travel.mapFromMainTip"),
  },
] as const;

function directionsEmbed(origin: string) {
  const saddr = encodeURIComponent(origin);
  return `https://maps.google.com/maps?saddr=${saddr}&daddr=${hotelQuery}&hl=zh-TW&output=embed`;
}

function directionsLink(origin: string) {
  return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(origin)}&destination=${hotelQuery}`;
}
---

<BaseLayout
  lang={lang}
  title={t("travel.metaTitle")}
  description={t("travel.metaDescription")}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t("travel.eyebrow")}</p>
      <h1>{t("travel.title")}</h1>
      <p class="lede">{t("travel.lede")}</p>
    </div>
  </section>

  <section class="section section-alt" id="room-block">
    <div class="container">
      <article class="card room-block-card">
        <p class="eyebrow">{t("travel.roomEyebrow")}</p>
        <h2>{t("travel.roomTitle")}</h2>
        <p>{t("travel.roomIntro")}</p>
        <ul class="travel-list">
          <li>
            <strong>{t("travel.roomDeadlineLabel")}</strong>
            {" "}
            {t("travel.roomDeadline")}
          </li>
          <li>
            <strong>{t("travel.roomRateLabel")}</strong>
            {" "}
            {t("travel.roomRate")}
          </li>
        </ul>
        <p class="form-note">{t("travel.roomPending")}</p>
        <p class="soft-cta">
          <strong>{t("travel.roomCtaStrong")}</strong>
          
          {t("travel.roomCtaRest")}
        </p>
      </article>
    </div>
  </section>

  <section class="section" id="getting-to-hotel">
    <div class="container">
      <p class="eyebrow">{t("travel.directionsEyebrow")}</p>
      <h2>{t("travel.directionsTitle")}</h2>
      <p class="lede">{t("travel.directionsLede")}</p>

      <div class="map-stack">
        {
          maps.map((item) => (
            <article class="card map-card" id={item.id}>
              <h3>{item.title}</h3>
              <div class="map-frame">
                <iframe
                  title={`${item.title} → Mandarin Oriental Taipei`}
                  src={directionsEmbed(item.originLabel)}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
              <p class="map-tip">{item.tip}</p>
              <p class="map-actions">
                <a
                  href={directionsLink(item.originLabel)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t("travel.mapOpen")}
                </a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>{t("travel.gettingTitle")}</h2>
        <p>{t("travel.gettingBody1")}</p>
        <p>{t("travel.gettingBody2")}</p>
      </article>
      <article class="card">
        <h2>{t("travel.aroundTitle")}</h2>
        <p>{t("travel.aroundBody")}</p>
      </article>
      <article class="card">
        <h2>{t("travel.neighborhoodTitle")}</h2>
        <p>{t("travel.neighborhoodBody")}</p>
      </article>
      <article class="card">
        <h2>{t("travel.stayTitle")}</h2>
        <p>{t("travel.stayBody")}</p>
      </article>
    </div>
  </section>
</BaseLayout>
