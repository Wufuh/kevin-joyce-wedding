---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);
const addressLines = t("details.venueAddress").split("\n");
---

<BaseLayout
  lang={lang}
  title={t("details.metaTitle")}
  description={t("details.metaDescription")}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t("details.eyebrow")}</p>
      <h1>{t("details.title")}</h1>
      <p class="lede">{t("details.lede")}</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>{t("details.dateTitle")}</h2>
        <p><strong>{t("details.dateValue")}</strong></p>
        <p>{t("details.dateNote")}</p>
      </article>
      <article class="card">
        <h2>{t("details.venueTitle")}</h2>
        <p><strong>{t("details.venueName")}</strong></p>
        <p>
          {addressLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      </article>
      <article class="card">
        <h2>{t("details.scheduleTitle")}</h2>
        <p><strong>{t("details.scheduleValue")}</strong></p>
        <p>{t("details.scheduleNote")}</p>
      </article>
      <article class="card">
        <h2>{t("details.dressTitle")}</h2>
        <p><strong>{t("details.dressValue")}</strong></p>
        <p>{t("details.dressNote")}</p>
      </article>
    </div>
  </section>
</BaseLayout>
