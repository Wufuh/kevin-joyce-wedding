---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t("story.metaTitle")}
  description={t("story.metaDescription")}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t("story.eyebrow")}</p>
      <h1>{t("story.title")}</h1>
      <p class="lede">{t("story.lede")}</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>{t("story.metTitle")}</h2>
        <p>{t("story.metBody")}</p>
      </article>
      <article class="card">
        <h2>{t("story.loveTitle")}</h2>
        <p>{t("story.loveBody")}</p>
      </article>
      <article class="card">
        <h2>{t("story.proposalTitle")}</h2>
        <p>{t("story.proposalBody")}</p>
      </article>
      <article class="card">
        <h2>{t("story.aheadTitle")}</h2>
        <p>{t("story.aheadBody")}</p>
      </article>
    </div>
  </section>
</BaseLayout>
