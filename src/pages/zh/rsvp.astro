---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "zh" as const;
const t = useTranslations(lang);

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || "meaqpryv";
const formAction = formspreeId
  ? `https://formspree.io/f/${formspreeId}`
  : undefined;
---

<BaseLayout
  lang={lang}
  title={t("rsvp.metaTitle")}
  description={t("rsvp.metaDescription")}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t("rsvp.eyebrow")}</p>
      <h1>{t("rsvp.title")}</h1>
      <p class="lede">{t("rsvp.lede")}</p>

      {
        formAction ? (
          <form class="form" method="POST" action={formAction}>
            <input type="hidden" name="_subject" value={t("rsvp.subject")} />
            <label>
              {t("rsvp.names")}
              <span class="hint">{t("rsvp.namesHint")}</span>
              <input
                type="text"
                name="names"
                required
                autocomplete="name"
                placeholder={t("rsvp.namesPlaceholder")}
              />
            </label>

            <label>
              {t("rsvp.email")}
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder={t("rsvp.emailPlaceholder")}
              />
            </label>

            <label>
              {t("rsvp.attending")}
              <select name="attending" required>
                <option value="" disabled selected>
                  {t("rsvp.attendingSelect")}
                </option>
                <option value="yes">{t("rsvp.attendingYes")}</option>
                <option value="no">{t("rsvp.attendingNo")}</option>
                <option value="maybe">{t("rsvp.attendingMaybe")}</option>
              </select>
            </label>

            <label>
              {t("rsvp.guestCount")}
              <span class="hint">{t("rsvp.guestCountHint")}</span>
              <input
                type="number"
                name="guest_count"
                min="0"
                max="20"
                step="1"
                required
                placeholder={t("rsvp.guestCountPlaceholder")}
              />
            </label>

            <label>
              {t("rsvp.dietary")}
              <span class="hint">{t("rsvp.dietaryHint")}</span>
              <textarea
                name="dietary"
                placeholder={t("rsvp.dietaryPlaceholder")}
              />
            </label>

            <label>
              {t("rsvp.message")}
              <textarea
                name="message"
                placeholder={t("rsvp.messagePlaceholder")}
              />
            </label>

            <button class="btn btn-primary" type="submit">
              {t("rsvp.submit")}
            </button>
            <p class="form-note">{t("rsvp.confirmNote")}</p>
          </form>
        ) : (
          <div class="card" style="max-width: 36rem;">
            <h2>{t("rsvp.notConfiguredTitle")}</h2>
            <p>
              {t("rsvp.notConfiguredBody")}{" "}
              <a href="https://formspree.io" rel="noopener noreferrer">
                formspree.io
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
