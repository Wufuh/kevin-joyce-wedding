---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Details"
  description="Wedding date, venue, schedule, and dress code for Kevin and Joyce in Taipei."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">The celebration</p>
      <h1>Wedding details</h1>
      <p class="lede">
        Everything you need for the day — we'll fill in the finer points as plans firm up.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>Date</h2>
        <p><strong>January 2027</strong></p>
        <p>Exact day and ceremony time coming soon.</p>
      </article>
      <article class="card">
        <h2>Venue</h2>
        <p><strong>Mandarin Oriental, Taipei</strong></p>
        <p>
          158 Dunhua North Road<br />
          Songshan District, Taipei, Taiwan
        </p>
      </article>
      <article class="card">
        <h2>Schedule</h2>
        <p><strong>TBD</strong></p>
        <p>
          Ceremony and reception timing will be posted here once confirmed.
          Guests will also receive details with their invitations.
        </p>
      </article>
      <article class="card">
        <h2>Dress code</h2>
        <p><strong>TBD</strong></p>
        <p>
          Formal guidance is still being finalized. We'll share colors and style
          notes here closer to the wedding.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
