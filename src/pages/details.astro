---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Details"
  description="Wedding details for Kevin and Joyce on January 2, 2027 at the Mandarin Oriental, Taipei — cocktail hour at 5:00 PM, reception only, cocktail attire."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">The celebration</p>
      <h1>Wedding details</h1>
      <p class="lede">
        Everything you need for the day — a reception-only celebration with cocktail hour to begin.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <article class="card">
        <h2>Date</h2>
        <p><strong>January 2, 2027</strong></p>
        <p>Reception only — there will be no ceremony.</p>
      </article>
      <article class="card">
        <h2>Venue</h2>
        <p><strong>Mandarin Oriental, Taipei</strong></p>
        <p>
          158 Dunhua North Road<br />
          Songshan District, Taipei, Taiwan
        </p>
      </article>
      <article class="card">
        <h2>Schedule</h2>
        <p><strong>Cocktail hour · 5:00 PM</strong></p>
        <p>
          Join us for cocktails at 5:00 PM. Dinner and celebration to follow.
        </p>
      </article>
      <article class="card">
        <h2>Dress code</h2>
        <p><strong>Cocktail</strong></p>
        <p>
          Cocktail attire — think polished and celebratory. Suits, dresses, or
          similarly elegant looks are all welcome.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
